# 生产配置模板。复制为 .env.production（scripts/deploy-remote.sh 读取），
# 把 <> 占位换成真实值后再部署。此文件含密钥，不要提交版本库。
#
# 两种上线方式（二选一，与部署脚本的 --proxy 参数对应）：
#   A. 已备案官网服务器 + 子域名（推荐，如 radar.你的已备案域名）：
#      部署命令加 --proxy，外层 nginx/宝塔反代到 http://127.0.0.1:8791 并负责 HTTPS 证书。
#   B. 独立香港/海外服务器 + 你的域名（未备案域名不能上内地服务器）：
#      自带 Caddy 自动签证书，占用 80/443，不加 --proxy。

NODE_ENV=production
PUBLIC_URL=https://radar.example.com
API_HOST=0.0.0.0
API_PORT=8791
DATABASE_PATH=/data/radar.sqlite
# 每日数据库备份：写在 DATABASE_PATH 同目录的 backups/，按北京时间每天一份，保留最近 N 份；0 关闭。
# 备份与主库同盘，防整盘丢失需另行把 /data/backups 拷到其他机器或对象存储。
DB_BACKUP_KEEP=7

# 管理员邮箱（真实邮箱，不能是 @example.test）；FEEDBACK_TO 不填默认第一个管理员
ADMIN_EMAILS=<你的常用邮箱>

# 登录会话签名密钥，32+ 随机字符。留空则部署脚本自动生成一次并写回本文件
AUTH_SECRET=

# 发信：阿里云邮件推送 DirectMail（先开通 https://dm.console.aliyun.com ）
# 步骤：发信域名填你的域名（域名 DNS 在阿里云的话按提示一键加验证记录）→
# 新建发信地址（如 noreply@你的域名）→ 设置该地址的 SMTP 密码
MAIL_MODE=smtp
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
MAIL_FROM=noreply@example.com
SMTP_USER=noreply@example.com
SMTP_PASS=<DirectMail SMTP 密码>

# 自动采集，默认每 24 小时一次
COLLECTOR_ENABLED=true
COLLECT_INTERVAL_MINUTES=1440

# 可选：服务器端机器翻译 sidecar（约占 1.5GB 内存，建议服务器 4GB 内存再开启）。
# 开启方法：部署命令加 --translate，并取消下一行注释
# TRANSLATION_URL=http://translate:5000/translate

# 大模型审核（智谱等）不在此配置：上线后在网站「设置」页填 API Key，存在服务器数据库里。

# 以下两项仅 B 方式（自带 Caddy）使用
RADAR_DOMAIN=radar.example.com
CADDY_ACME_EMAIL=<你的常用邮箱>
