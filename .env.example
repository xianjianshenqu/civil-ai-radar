# Copy locally to .env; never commit actual credentials.
NODE_ENV=development
PUBLIC_URL=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8791
MAIL_MODE=local
ADMIN_EMAILS=admin@example.test
COLLECTOR_ENABLED=true
COLLECT_INTERVAL_MINUTES=1440
# Production: NODE_ENV=production, HTTPS PUBLIC_URL, MAIL_MODE=resend or smtp,
# verified MAIL_FROM, RESEND_API_KEY (resend) or SMTP credentials (smtp),
# AUTH_SECRET (32+ random characters), ADMIN_EMAILS (not @example.test),
# and DATABASE_PATH on a persistent volume.
# AUTH_SECRET=
# RESEND_API_KEY=
# MAIL_FROM=
# FEEDBACK_TO=
# DATABASE_PATH=/data/radar.sqlite
# CADDY_ACME_EMAIL=you@domain.example
# RADAR_DOMAIN=radar.example.com

# SMTP provider (e.g. Aliyun DirectMail for domestic delivery), MAIL_MODE=smtp:
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_SECURE defaults true on port 465 (implicit TLS); other ports require STARTTLS
# SMTP_USER=noreply@yourdomain
# SMTP_PASS=smtp-password

# LibreTranslate-compatible /translate endpoint. Without this, built-in
# bilingual editorial editions still work; new feed items stay in the source language.
# Local Argos models: npm run dev:translate
# TRANSLATION_URL=http://127.0.0.1:5001/translate
# Docker sidecar: docker compose --profile translate up -d
# TRANSLATION_URL=http://translate:5000/translate
# TRANSLATION_API_KEY=

# Optional OpenAI-compatible chat completions endpoint for P0/P1 extraction only.
# Without this, high-value items still get a rules-based 机器整理 note; P3 still archives.
# REVIEW_MODEL_URL=https://api.openai.com/v1/chat/completions
# REVIEW_MODEL_KEY=
# OPENAI_API_KEY=
# REVIEW_MODEL=gpt-4o-mini

# Optional polite contact for Crossref / OpenAlex. Never use @example.test.
# ACADEMIC_MAILTO=ops@radar.example
